<div class="kinetix-hero-shopify" style="padding: 6rem 1.5rem; text-align: center; background: #060c18; color: #f8fafc; position: relative; overflow: hidden;">
  <div style="max-width: 820px; margin: 0 auto; position: relative; z-index: 2;">
    <span style="display: inline-block; padding: 0.35rem 0.95rem; border-radius: 9999px; background: rgba(56,189,248,0.08); border: 1px solid rgba(56,189,248,0.25); color: #38bdf8; font-size: 0.75rem; font-weight: 800; letter-spacing: 0.12em; margin-bottom: 1.5rem; font-family: monospace;">
      {{ section.settings.badge | escape }}
    </span>
    <h1 style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: clamp(2.25rem, 5.5vw, 4rem); font-weight: 800; line-height: 1.1; margin: 0 0 1.5rem; color: #f8fafc; letter-spacing: -0.03em;">
      {{ section.settings.heading | escape }}
    </h1>
    <p style="font-size: 1.125rem; color: #94a3b8; line-height: 1.65; margin: 0 0 2.25rem;">
      {{ section.settings.subtext | escape }}
    </p>
    <div>
      <a href="{{ section.settings.button_link }}" style="display: inline-flex; align-items: center; gap: 0.75rem; background: #f8fafc; color: #060c18; font-weight: 800; padding: 0.9rem 2rem; border-radius: 9999px; text-decoration: none; box-shadow: 0 10px 25px rgba(0,0,0,0.5), 0 0 20px rgba(248,250,252,0.15);">
        <span>{{ section.settings.button_label | escape }}</span>
        <span style="width: 24px; height: 24px; border-radius: 9999px; background: rgba(6,12,24,0.12); display: inline-flex; align-items: center; justify-content: center; font-size: 0.75rem;">→</span>
      </a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Kinetix Hero Banner",
  "settings": [
    { "type": "text", "id": "badge", "label": "Badge Tag", "default": "SERIES 04 / OLYMPIC CALIBER TRAINING SYSTEMS" },
    { "type": "text", "id": "heading", "label": "Main Heading", "default": "Technical Training Apparel & Strength Systems" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "High-tensile bonded microfibers, graduated compression, and competition-tested barbell abrasion guards." },
    { "type": "text", "id": "button_label", "label": "Button Label", "default": "Shop The Drop" },
    { "type": "url", "id": "button_link", "label": "Button Link" }
  ],
  "presets": [
    { "name": "Kinetix Hero Banner" }
  ]
}
{% endschema %}
