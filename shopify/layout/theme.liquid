<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="canonical" href="{{ canonical_url }}">
    <title>{{ page_title }} &ndash; {{ shop.name }}</title>
    {{ content_for_header }}
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap">
    <style>
      :root {
        --bg-deep: #060c18;
        --bg-base: #0a1424;
        --bg-surface: #0e1c31;
        --text-primary: #f8fafc;
        --text-secondary: #94a3b8;
        --accent-primary: #38bdf8;
        --border-glass: rgba(255, 255, 255, 0.08);
        --font-display: 'Plus Jakarta Sans', sans-serif;
      }
      body { background: var(--bg-deep); color: var(--text-primary); font-family: 'Plus Jakarta Sans', sans-serif; margin: 0; line-height: 1.6; }
    </style>
  </head>
  <body class="kinetix-shopify-body">
    {% section 'announcement-bar' %}
    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>
    {% section 'footer' %}
  </body>
</html>
